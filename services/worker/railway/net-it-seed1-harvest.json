{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/worker/Dockerfile",
    "watchPatterns": ["services/worker/**"]
  },
  "deploy": {
    "startCommand": "python -m app.net_it_seed1_pipeline --mode harvest --limit 20 --persist",
    "cronSchedule": "22 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
