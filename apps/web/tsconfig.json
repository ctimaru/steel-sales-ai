{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/app/(platform)/*": ["./app/(italian)/(platform)/*"],
      "@/app/(public)/*": ["./app/(italian)/(public)/*"],
      "@/app/(workspace)/*": ["./app/(italian)/(workspace)/*"],
      "@/app/en/*": ["./app/(english)/en/*"],
      "@/app/cookies/*": ["./app/(italian)/cookies/*"],
      "@/app/evidence/*": ["./app/(italian)/evidence/*"],
      "@/app/forgot-password/*": ["./app/(italian)/forgot-password/*"],
      "@/app/investitori/*": ["./app/(italian)/investitori/*"],
      "@/app/legal/*": ["./app/(italian)/legal/*"],
      "@/app/login/*": ["./app/(italian)/login/*"],
      "@/app/onboarding/*": ["./app/(italian)/onboarding/*"],
      "@/app/privacy/*": ["./app/(italian)/privacy/*"],
      "@/app/register/*": ["./app/(italian)/register/*"],
      "@/app/registration/*": ["./app/(italian)/registration/*"],
      "@/app/reset-password/*": ["./app/(italian)/reset-password/*"],
      "@/app/staff/*": ["./app/(italian)/staff/*"],
      "@/app/terms/*": ["./app/(italian)/terms/*"],
      "@/app/verify-email/*": ["./app/(italian)/verify-email/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
